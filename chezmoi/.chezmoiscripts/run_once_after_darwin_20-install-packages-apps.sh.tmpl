{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/sh

# Install Mac Apps via Homebrew Cask

source /tmp/chezmoi-utils.sh

printf "${green}[20 - macOS] ${reset}"
{{- if or (lt 20 (atoi (env "SCRIPTS_START_AT"))) (env "SKIP_APPS") }}
echo "Skip installing Mac Apps via Homebrew Cask"
exit 0
{{ else }}
echo "Install Mac Apps via Homebrew Cask"
{{- end }}

set -eufo pipefail

{{ $taps := list -}}

{{ $brews := list
  "awscli"
  "bitwarden-cli"
  "cloudflared"
  "ffmpeg"
  "yt-dlp"
  "ghq"
  "mas"
  "n"
  "ni"
  "pnpm"
  "gnupg"
  "starship"
  "wget"
  "woff2"
  "yarn"
  "oven-sh/bun/bun"
  "infisical/get-cli/infisical"
-}}

{{ $casks := list
  "betterdisplay"
  "cloudflare-warp"
  "cyberduck"
  "datagrip"
  "discord"
  "figma"
  "google-chrome"
  "logi-options+"
  "microsoft-teams"
  "opera"
  "orbstack"
  "postman"
  "spotify"
  "telegram"
  "the-unarchiver"
  "visual-studio-code"
  "warp"
-}}

brew bundle --file=/dev/stdin <<EOF || :
{{ range ($taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end }}
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end }}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end }}
EOF
{{ end -}}
